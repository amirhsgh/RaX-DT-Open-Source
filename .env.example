# Copy this file to .env and adjust as needed, then run: docker compose up
#
# Nothing below is required to get the app running - docker-compose.yml
# already has working defaults for everything except the chatbot's API key.

# ---- Chatbot (optional) --------------------------------------------------
# Leave unset and the chatbot still works - it just replies with a canned
# mock response instead of calling a real model. Set this to get real
# answers: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Docking (optional) ---------------------------------------------------
# GNINA docking runs on CPU by default so it works on any machine. Set to
# "true" only if this host has an NVIDIA GPU and Docker's nvidia runtime.
GNINA_USE_GPU=false
